# OpenTerminal Express API (not the Next.js web server)
OPENTERMINAL_API_URL=http://127.0.0.1:4000
OPENTERMINAL_TIMEOUT_SECONDS=10

# TWS paper: 127.0.0.1:7497 | IB Gateway paper: 127.0.0.1:4002
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=31
IBKR_TIMEOUT_SECONDS=8

# Independent quant database; does not share OpenTerminal's portfolio database
DATABASE_PATH=./data/quant.db

# Bar settings, independently configurable by analysis horizon
SWING_DURATION=2 Y
SWING_BAR_SIZE=1 day
INTRADAY_DURATION=5 D
INTRADAY_BAR_SIZE=5 mins
DAY_TRADING_DURATION=1 D
DAY_TRADING_BAR_SIZE=5 mins
